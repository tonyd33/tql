-- a highlighted query
is_alloc : Filter node bool;
--         ^ type.builtin
main =
  do {
    fn <- . / :function_definition;
--  ^ variable
--             ^ type
    let name = fn.name;
--      ^ function
--                ^ attribute
    if name ~ r"^alloc" then { n = name } else empty
--  ^ keyword
--            ^ string.regex
--                             ^ property
  };
