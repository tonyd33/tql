-- a highlighted query
data Size = Small | Large Int;
-- <- keyword
--   ^ type
--                        ^ type

start :: {start_byte: Int | r} -> Int;
-- <- function
--        ^ property
--                          ^ type
start = _.start_byte;
--        ^ property

is_alloc :: Filter Node Node;
-- <- function
--          ^ type.builtin
--                 ^ type
is_alloc = #declarator | keep (\d -> text d ~ r"^alloc");
--          ^ attribute
--                              ^ variable.parameter
--                                            ^ string.regex

size xs = case xs of { [] -> Small; x : rest -> Large (length rest) };
--   ^ variable.parameter
--        ^ keyword
--                ^ keyword

clamp x = x `max` 0;
--           ^ function

halves = map (`div` 2) . filter (0 <);
--             ^ function

main root = do {
-- <- function
--   ^ variable.parameter
--          ^ keyword
  fn <- descendants_of_kind :function_definition root;
--^ variable
--                          ^ type
  name <- fn#declarator;
--^ variable
--           ^ attribute
  let line = (range fn).start_point.row;
--^ keyword
--    ^ function
--                      ^ property
  guard $ not (has is_alloc fn) and start (range fn) >= 0;
--                              ^ keyword
  return if true then { name = text name, line = line } else { name = "", line = 0 };
--       ^ keyword
--          ^ constant.builtin
--               ^ keyword
--                      ^ property
--                                                                    ^ string
--                                                                               ^ number
};

first_call root = do {
  call@(of_kind :call_expression -> [_]) & (#function -> [f]) <- descendants root;
--^ variable
--    ^ operator
--                                       ^ operator
  return f;
};

callee root = do {
  c@:call_expression { #function = f } <- descendants root;
--                      ^ attribute
  return f;
};

sign n = case n of { 0 -> 0; m if m > 0 -> 1; _ -> 0 - 1 };
--                             ^ keyword

pattern Callee c <- :call_expression { #function = c };
-- <- keyword
--      ^ type
--             ^ variable.parameter

arrows = descendants | of_shape :arrow_function {};
--                     ^ keyword
