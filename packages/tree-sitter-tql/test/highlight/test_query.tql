. > function_definition as @fn
--                         ^ variable
--           ^ property
|
@fn > function_declarator as @fn_decl |
@fn_decl > identifier as @name |
@fn.body as @body
--   ^ attribute
|
select(any(@body >> call_expression; .function ~ /^(k|v|kv)(z|m|c|re)?alloc/))
-- ^ function
--                                                   ^ string.regex
|
{ @name }
