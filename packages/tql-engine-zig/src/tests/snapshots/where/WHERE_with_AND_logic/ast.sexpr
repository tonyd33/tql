(source_file (pipeline (bind (child . (node class_declaration)) c) (bind (field c name) class_name) (bind (field c body) body) (bind (child body (node method_definition)) method_def) (bind (field method_def name) method_name) (transform (call select (and (eq class_name (string "Service")) (eq method_name (string "foo"))))) (transform c)))