-- TQL prelude.

data List a = Nil | Cons a (List a) deriving (Eq, Ord, Serial);

data Bool = False | True deriving (Eq, Ord, Serial);

data Unit = Unit deriving (Eq, Ord);

data Ordering = LT | EQ | GT deriving (Eq, Ord);

class Eq a where {
  eq :: a -> a -> Bool;
};

class Eq a => Ord a where {
  compare :: a -> a -> Ordering;
};

class Sized a where {
  length :: a -> Int;
};

instance Sized String where {
  length = %string_length;
};

instance Sized [a] where {
  length xs = let {
    foldl_strict f z ys = case ys of {
      Nil -> z;
      Cons h t -> let { z2 = f z h; } in seq z2 $ foldl_strict f z2 t;
    };
    acc n _ = n + 1;
  } in foldl_strict acc 0 xs;
};

-- Primitives

seq :: a -> b -> b;
seq = %seq;

text :: Node -> String;
text = %text;

kind :: Node -> Kind;
kind = %kind;

kind_name :: Node -> String;
kind_name = %kind_name;

is_named :: Node -> Bool;
is_named = %is_named;

is_extra :: Node -> Bool;
is_extra = %is_extra;

range :: Node -> Range;
range = %range;

mod :: Int -> Int -> Int;
mod = %mod;

toint :: Filter String Int;
toint = %toint;

filename :: Filter Node String;
filename = %filename;

parent :: Filter Node Node;
parent = %parent;

ancestors :: Filter Node Node;
ancestors = %ancestors;

children :: Filter Node Node;
children = %children;

named_children :: Filter Node Node;
named_children = %named_children;

descendants :: Filter Node Node;
descendants = %descendants;

named_descendants :: Filter Node Node;
named_descendants = %named_descendants;

children_of_kind :: Kind -> Filter Node Node;
children_of_kind = %children_of_kind;

descendants_of_kind :: Kind -> Filter Node Node;
descendants_of_kind = %descendants_of_kind;

of_kind :: Kind -> Filter Node Node;
of_kind = %of_kind;

is_kind :: Kind -> Node -> Bool;
is_kind = %is_kind;

-- Functional helpers

identity :: a -> a;
identity x = x;

const :: a -> b -> a;
const x y = x;

compose :: (b -> c) -> (a -> b) -> a -> c;
compose f g x = f (g x);

flip :: (a -> b -> c) -> b -> a -> c;
flip f x y = f y x;

subtract :: Int -> Int -> Int;
subtract x y = y - x;

null :: [a] -> Bool;
null xs = case xs of {
  Nil -> True;
  Cons h t -> False;
};

append :: [a] -> [a] -> [a];
append xs ys = case xs of {
  Nil -> ys;
  Cons h t -> Cons h (append t ys);
};

concat :: [[a]] -> [a];
concat xss = case xss of {
  Nil -> Nil;
  Cons h t -> append h $ concat t;
};

map :: (a -> b) -> [a] -> [b];
map f xs = case xs of {
  Nil -> Nil;
  Cons h t -> Cons (f h) $ map f t;
};

concat_map :: (a -> [b]) -> [a] -> [b];
concat_map f xs = case xs of {
  Nil -> Nil;
  Cons h t -> append (f h) $ concat_map f t;
};

filter :: (a -> Bool) -> [a] -> [a];
filter p xs = case xs of {
  Nil -> Nil;
  Cons h t -> case p h of {
    False -> filter p t;
    True -> Cons h $ filter p t;
  };
};

foldr :: (a -> b -> b) -> b -> [a] -> b;
foldr f z xs = case xs of {
  Nil -> z;
  Cons h t -> f h $ foldr f z t;
};

not :: Bool -> Bool;
not b = case b of {
  False -> True;
  True -> False;
};

and :: Bool -> Bool -> Bool;
and a b = case a of {
  False -> False;
  True -> b;
};

or :: Bool -> Bool -> Bool;
or a b = case a of {
  False -> b;
  True -> True;
};

any :: (a -> Bool) -> [a] -> Bool;
any p xs = case xs of {
  Nil -> False;
  Cons h t -> or (p h) $ any p t;
};

all :: (a -> Bool) -> [a] -> Bool;
all p xs = case xs of {
  Nil -> True;
  Cons h t -> and (p h) $ all p t;
};

guard :: Bool -> [Unit];
guard b = case b of {
  False -> Nil;
  True -> Cons Unit Nil;
};

-- FIXME: Consider removing this while we don't truly have functors as it can
-- be confused with `pure`
return :: a -> List a;
return a = [a];

take :: Int -> [a] -> [a];
take n xs = if n <= 0 then Nil else case xs of {
  Nil -> Nil;
  Cons h t -> Cons h $ take (n - 1) t;
};

drop :: Int -> [a] -> [a];
drop n xs = if n <= 0 then xs else case xs of {
  Nil -> Nil;
  Cons h t -> drop (n - 1) t;
};

head :: [a] -> [a];
head xs = take 1 xs;

tail :: [a] -> [a];
tail xs = drop 1 xs;

-- The query layer. `Filter a b` is `a -> [b]`, the Kleisli category of the
-- list monad. Every name below is that monad's, or a list function lifted
-- into it.

-- FIXME: Consider removing this while we don't truly have functors as it can
-- be confused with `return`
pure :: a -> Filter b a;
pure v x = [v];

none :: Filter a b;
none x = [];

kleisli :: Filter a b -> Filter b c -> Filter a c;
kleisli p q x = concat_map q (p x);

alt :: Filter a b -> Filter a b -> Filter a b;
alt p q x = append (p x) (q x);

arr :: (a -> b) -> Filter a b;
arr f x = [f x];

collect :: Filter a b -> Filter a [b];
collect p x = [p x];

keep :: (a -> Bool) -> Filter a a;
keep p x = case p x of {
  False -> Nil;
  True -> Cons x Nil;
};

has :: Filter a b -> a -> Bool;
has p x = not $ null $ p x;

first :: Filter a b -> Filter a b;
first p x = head (p x);

or_else :: Filter a b -> Filter a b -> Filter a b;
or_else primary fallback x = case primary x of {
  Nil -> fallback x;
  Cons h t -> Cons h t;
};
