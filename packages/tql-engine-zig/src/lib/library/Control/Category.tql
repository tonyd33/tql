module Control.Category (Category(..), compose_flipped);

class Category k where {
  identity :: k a a;
  compose :: k b c -> k a b -> k a c;
};

instance Category (->) where {
  identity x = x;
  compose f g x = f (g x);
};

compose_flipped :: Category k => k a b -> k b c -> k a c;
compose_flipped f g = compose g f;
