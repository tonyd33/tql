module Data.Filter (
  always,
  none,
  kleisli,
  union,
  arr,
  collect,
  keep,
  has,
  first,
  or_else,
);

import Prim (List(..), Bool(..));
import Data.Bool (not);
import Data.List (null, concat_map, head);
import Control.Applicative (Applicative(..), Alternative(..));

-- `Filter a b` is `a -> [b]`.

always :: Applicative f => b -> a -> f b;
always v x = pure v;

none :: Alternative f => a -> f b;
none x = empty;

kleisli :: Filter a b -> Filter b c -> Filter a c;
kleisli p q x = concat_map q (p x);

union :: Alternative f => (a -> f b) -> (a -> f b) -> a -> f b;
union p q x = alt (p x) (q x);

arr :: Applicative f => (a -> b) -> a -> f b;
arr f x = pure (f x);

collect :: Filter a b -> Filter a [b];
collect p x = [p x];

keep :: Alternative f => (a -> Bool) -> a -> f a;
keep p x = case p x of {
  False -> empty;
  True -> pure x;
};

has :: Filter a b -> a -> Bool;
has p x = not $ null $ p x;

first :: Filter a b -> Filter a b;
first p x = head (p x);

or_else :: Filter a b -> Filter a b -> Filter a b;
or_else primary fallback x = case primary x of {
  Nil -> fallback x;
  results -> results;
};
