module Data.Filter (
  Filter,
  run,
  collect,
  keep,
  has,
  or_else,
);

import Prim (Bool, List);
import Data.Bool (not);
import Control.Applicative (Applicative(..), Alternative(..));
import Data.Foldable (null);
import Control.Arrow (Kleisli(..), run_kleisli);

type Filter = Kleisli List;

run :: Filter a b -> a -> [b];
run = run_kleisli;

collect :: Filter a b -> Filter a [b];
collect p = Kleisli $ \x -> pure $ run p x;

keep :: (a -> Bool) -> Filter a a;
keep p = Kleisli $ \x -> if p x then pure x else empty;

has :: Filter a b -> a -> Bool;
has p x = not $ null $ run p x;

or_else :: Filter a b -> Filter a b -> Filter a b;
or_else primary fallback = Kleisli $ \x -> let {
  results = run primary x;
} in if null results then run fallback x else results;
