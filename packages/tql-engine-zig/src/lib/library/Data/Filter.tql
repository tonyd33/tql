module Data.Filter (
  always,
  none,
  kleisli,
  union,
  arr,
  collect,
  keep,
  has,
  first,
  or_else,
);

import Prim (Bool(..));
import Data.Bool (not);
import Control.Applicative (Applicative(..), Alternative(..));
import Data.Foldable (Foldable(..), to_list, null);
import Control.Monad (kleisli);

always :: Applicative f => b -> a -> f b;
always v x = pure v;

none :: Alternative f => a -> f b;
none x = empty;

union :: Alternative f => (a -> f b) -> (a -> f b) -> a -> f b;
union p q x = alt (p x) (q x);

arr :: Applicative f => (a -> b) -> a -> f b;
arr f x = pure (f x);

collect :: (Foldable g, Applicative f) => (a -> g b) -> a -> f [b];
collect p x = pure $ to_list $ p x;

keep :: Alternative f => (a -> Bool) -> a -> f a;
keep p x = case p x of {
  False -> empty;
  True -> pure x;
};

has :: Foldable f => (a -> f b) -> a -> Bool;
has p x = not $ null $ p x;

first :: Foldable f => (a -> f b) -> a -> [b];
first p x = foldr (\y _ -> [y]) [] $ p x;

or_else :: Foldable f => (a -> f b) -> (a -> f b) -> a -> f b;
or_else primary fallback x = let {
  results = primary x;
} in if null results then fallback x else results;
