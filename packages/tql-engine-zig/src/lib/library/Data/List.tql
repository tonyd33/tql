module Data.List (
  List(..),
  Sized(..),
  foldl',
  filter,
  zip,
  unzip,
  take,
  drop,
  head,
  last,
  tail,
  init,
);

import Prim (Int, String, List(..), Bool(..), seq);
import Prim (string_length) as P;
import Data.Tuple (fst, snd);
import Data.Maybe (Maybe(..));

class Sized a where {
  length :: a -> Int;
};

instance Sized String where {
  length = P.string_length;
};

instance Sized [a] where {
  length xs = foldl' (\n _ -> n + 1) 0 xs;
};

foldl' :: (b -> a -> b) -> b -> [a] -> b;
foldl' f z xs = case xs of {
  Nil -> z;
  Cons h t -> let { z' = f z h; } in seq z' $ foldl' f z' t;
};

filter :: (a -> Bool) -> [a] -> [a];
filter p xs = case xs of {
  Nil -> Nil;
  Cons h t -> case p h of {
    False -> filter p t;
    True -> Cons h $ filter p t;
  };
};

zip :: [a] -> [b] -> [(a, b)];
zip xs ys = case xs of {
  Nil -> Nil;
  Cons x xt -> case ys of {
    Nil -> Nil;
    Cons y yt -> Cons (x, y) $ zip xt yt;
  };
};

unzip :: [(a, b)] -> ([a], [b]);
unzip ps = case ps of {
  Nil -> ([], []);
  Cons p rest -> let {
    unzipped = unzip rest;
  } in (Cons (fst p) (fst unzipped), Cons (snd p) (snd unzipped));
};

take :: Int -> [a] -> [a];
take n xs = if n <= 0 then Nil else case xs of {
  Nil -> Nil;
  Cons h t -> Cons h $ take (n - 1) t;
};

drop :: Int -> [a] -> [a];
drop n xs = if n <= 0 then xs else case xs of {
  Nil -> Nil;
  Cons h t -> drop (n - 1) t;
};

head :: [a] -> Maybe a;
head xs = case xs of {
  [] -> Nothing;
  x : _ -> Just x;
};

last :: [a] -> Maybe a;
last xs = case xs of {
  [] -> Nothing;
  [x] -> Just x;
  _ : rest -> last rest;
};

tail :: [a] -> Maybe [a];
tail xs = case xs of {
  [] -> Nothing;
  _ : rest -> Just rest;
};

init :: [a] -> Maybe [a];
init xs = case xs of {
  [] -> Nothing;
  x : rest -> Just $ case init rest of {
    Nothing -> [];
    Just front -> x : front;
  };
};
