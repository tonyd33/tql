module Data.List (
  List(..),
  Sized(..),
  filter,
  take,
  drop,
  head,
  tail,
);

import Prim (Int, String, List(..), Bool(..), seq);

class Sized a where {
  length :: a -> Int;
};

instance Sized String where {
  length = %string_length;
};

instance Sized [a] where {
  length xs = let {
    foldl_strict f z ys = case ys of {
      Nil -> z;
      Cons h t -> let { z2 = f z h; } in seq z2 $ foldl_strict f z2 t;
    };
    acc n _ = n + 1;
  } in foldl_strict acc 0 xs;
};

filter :: (a -> Bool) -> [a] -> [a];
filter p xs = case xs of {
  Nil -> Nil;
  Cons h t -> case p h of {
    False -> filter p t;
    True -> Cons h $ filter p t;
  };
};

take :: Int -> [a] -> [a];
take n xs = if n <= 0 then Nil else case xs of {
  Nil -> Nil;
  Cons h t -> Cons h $ take (n - 1) t;
};

drop :: Int -> [a] -> [a];
drop n xs = if n <= 0 then xs else case xs of {
  Nil -> Nil;
  Cons h t -> drop (n - 1) t;
};

head :: [a] -> [a];
head xs = take 1 xs;

tail :: [a] -> [a];
tail xs = drop 1 xs;
