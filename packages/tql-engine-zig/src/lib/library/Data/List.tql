module Data.List (
  List(..),
  Sized(..),
  filter,
  zip,
  unzip,
  take,
  drop,
  head,
  tail,
);

import Prim (Int, String, List(..), Bool(..), seq);
import Data.Tuple (fst, snd);

class Sized a where {
  length :: a -> Int;
};

instance Sized String where {
  length = %string_length;
};

instance Sized [a] where {
  length xs = let {
    foldl_strict f z ys = case ys of {
      Nil -> z;
      Cons h t -> let { z2 = f z h; } in seq z2 $ foldl_strict f z2 t;
    };
    acc n _ = n + 1;
  } in foldl_strict acc 0 xs;
};

filter :: (a -> Bool) -> [a] -> [a];
filter p xs = case xs of {
  Nil -> Nil;
  Cons h t -> case p h of {
    False -> filter p t;
    True -> Cons h $ filter p t;
  };
};

zip :: [a] -> [b] -> [(a, b)];
zip xs ys = case xs of {
  Nil -> Nil;
  Cons x xt -> case ys of {
    Nil -> Nil;
    Cons y yt -> Cons (x, y) $ zip xt yt;
  };
};

unzip :: [(a, b)] -> ([a], [b]);
unzip ps = case ps of {
  Nil -> ([], []);
  Cons p rest -> let {
    unzipped = unzip rest;
  } in (Cons (fst p) (fst unzipped), Cons (snd p) (snd unzipped));
};

take :: Int -> [a] -> [a];
take n xs = if n <= 0 then Nil else case xs of {
  Nil -> Nil;
  Cons h t -> Cons h $ take (n - 1) t;
};

drop :: Int -> [a] -> [a];
drop n xs = if n <= 0 then xs else case xs of {
  Nil -> Nil;
  Cons h t -> drop (n - 1) t;
};

head :: [a] -> [a];
head xs = take 1 xs;

tail :: [a] -> [a];
tail xs = drop 1 xs;
