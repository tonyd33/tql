module Data.List (
  List(..),
  Sized(..),
  null,
  concat,
  concat_map,
  filter,
  foldr,
  any,
  all,
  take,
  drop,
  head,
  tail,
);

import Prim (Int, String, List(..), Bool(..), seq);
import Data.Bool (and, or);
import Data.Monoid (Semigroup(..));

class Sized a where {
  length :: a -> Int;
};

instance Sized String where {
  length = %string_length;
};

instance Sized [a] where {
  length xs = let {
    foldl_strict f z ys = case ys of {
      Nil -> z;
      Cons h t -> let { z2 = f z h; } in seq z2 $ foldl_strict f z2 t;
    };
    acc n _ = n + 1;
  } in foldl_strict acc 0 xs;
};

null :: [a] -> Bool;
null xs = case xs of {
  Nil -> True;
  Cons h t -> False;
};

concat :: [[a]] -> [a];
concat xss = case xss of {
  Nil -> Nil;
  Cons h t -> append h $ concat t;
};

concat_map :: (a -> [b]) -> [a] -> [b];
concat_map f xs = case xs of {
  Nil -> Nil;
  Cons h t -> append (f h) $ concat_map f t;
};

filter :: (a -> Bool) -> [a] -> [a];
filter p xs = case xs of {
  Nil -> Nil;
  Cons h t -> case p h of {
    False -> filter p t;
    True -> Cons h $ filter p t;
  };
};

foldr :: (a -> b -> b) -> b -> [a] -> b;
foldr f z xs = case xs of {
  Nil -> z;
  Cons h t -> f h $ foldr f z t;
};

any :: (a -> Bool) -> [a] -> Bool;
any p xs = case xs of {
  Nil -> False;
  Cons h t -> or (p h) $ any p t;
};

all :: (a -> Bool) -> [a] -> Bool;
all p xs = case xs of {
  Nil -> True;
  Cons h t -> and (p h) $ all p t;
};

take :: Int -> [a] -> [a];
take n xs = if n <= 0 then Nil else case xs of {
  Nil -> Nil;
  Cons h t -> Cons h $ take (n - 1) t;
};

drop :: Int -> [a] -> [a];
drop n xs = if n <= 0 then xs else case xs of {
  Nil -> Nil;
  Cons h t -> drop (n - 1) t;
};

head :: [a] -> [a];
head xs = take 1 xs;

tail :: [a] -> [a];
tail xs = drop 1 xs;
