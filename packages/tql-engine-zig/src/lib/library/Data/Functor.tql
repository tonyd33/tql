module Data.Functor (Functor(..));

import Prim (List(..), Maybe(..));

class Functor f where {
  map :: (a -> b) -> f a -> f b;
  deriving %derive_functor;
};

instance Functor List where {
  map f xs = case xs of {
    Nil -> Nil;
    Cons h t -> Cons (f h) $ map f t;
  };
};

instance Functor Maybe where {
  map f m = case m of {
    Nothing -> Nothing;
    Just x -> Just (f x);
  };
};
