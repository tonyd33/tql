module Data.Node (
  Node,
  Kind,
  Range,
  Point,
  text,
  kind,
  kind_name,
  is_named,
  is_extra,
  is_error,
  is_missing,
  has_error,
  range,
  filename,
  parent,
  ancestors,
  children,
  named_children,
  descendants,
  named_descendants,
  children_of_kind,
  descendants_of_kind,
  of_kind,
  is_kind,
);

import Prim;
import Prim (parent, ancestors, children, named_children, descendants, named_descendants, children_of_kind, descendants_of_kind) as P;
import Data.Filter (Filter, run);
import Control.Arrow (Kleisli(..));
import Data.Functor (Functor(..));

parent :: Filter Node Node;
parent = Kleisli P.parent;

ancestors :: Filter Node Node;
ancestors = Kleisli P.ancestors;

children :: Filter Node Node;
children = Kleisli P.children;

named_children :: Filter Node Node;
named_children = Kleisli P.named_children;

descendants :: Filter Node Node;
descendants = Kleisli P.descendants;

named_descendants :: Filter Node Node;
named_descendants = Kleisli P.named_descendants;

children_of_kind :: Kind -> Filter Node Node;
children_of_kind k = Kleisli $ P.children_of_kind k;

descendants_of_kind :: Kind -> Filter Node Node;
descendants_of_kind k = Kleisli $ P.descendants_of_kind k;

of_kind :: Kind -> Filter Node Node;
of_kind k = Kleisli $ \x -> if is_kind k x then [x] else [];

run_main :: ToJson t => Filter Node t -> Node -> [Json];
run_main m root = map to_json $ run m root;
