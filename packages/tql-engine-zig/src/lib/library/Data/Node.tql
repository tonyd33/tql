module Data.Node (
  Node,
  Kind,
  Range,
  Point,
  text,
  kind,
  kind_name,
  is_named,
  is_extra,
  range,
  filename,
  parent,
  ancestors,
  children,
  named_children,
  descendants,
  named_descendants,
  children_of_kind,
  descendants_of_kind,
  of_kind,
  is_kind,
);

import Prim;
import Prim (filename, parent, ancestors, children, named_children, descendants, named_descendants, children_of_kind, descendants_of_kind) as P;
import Data.Filter (Filter(..));

filename :: Filter Node String;
filename = Filter P.filename;

parent :: Filter Node Node;
parent = Filter P.parent;

ancestors :: Filter Node Node;
ancestors = Filter P.ancestors;

children :: Filter Node Node;
children = Filter P.children;

named_children :: Filter Node Node;
named_children = Filter P.named_children;

descendants :: Filter Node Node;
descendants = Filter P.descendants;

named_descendants :: Filter Node Node;
named_descendants = Filter P.named_descendants;

children_of_kind :: Kind -> Filter Node Node;
children_of_kind k = Filter (P.children_of_kind k);

descendants_of_kind :: Kind -> Filter Node Node;
descendants_of_kind k = Filter (P.descendants_of_kind k);

of_kind :: Kind -> Filter Node Node;
of_kind k = Filter (\x -> case is_kind k x of {
  False -> Nil;
  True -> Cons x Nil;
});
