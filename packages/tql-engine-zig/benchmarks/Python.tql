import Data.Foldable (null);

is_mutable n = is_kind :list n or is_kind :dictionary n or is_kind :set n;

mutable_default =
  (descendants_of_kind :default_parameter <|> descendants_of_kind :typed_default_parameter)
  | #value
  | keep is_mutable;

bare_except = descendants_of_kind :except_clause | keep (null . #value);

function_depth = length . (ancestors | of_kind :function_definition);

nested_function = descendants_of_kind :function_definition | keep ((>= 2) . function_depth);

max_of acc xs = case xs of {
  [] -> acc;
  h : t -> if h > acc then max_of h t else max_of acc t;
};

block_depth n = (if is_kind :block n then 1 else 0) + max_of 0 (map block_depth (named_children n));

deep_function = descendants_of_kind :function_definition | keep ((>= 6) . block_depth);

row n = { kind = kind n, row = (range n).start_point.row };

main = (mutable_default <|> bare_except <|> nested_function <|> deep_function) | arr row;
