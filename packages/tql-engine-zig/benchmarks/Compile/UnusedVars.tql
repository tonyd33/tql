module Compile.UnusedVars (unused_vars) for javascript;

import Data.Foldable (any, null, concat_map);
import Data.List (filter, take);

is_one_of ks n = any (= kind n) ks;

function_kinds = [:function_declaration, :function_expression, :arrow_function, :method_definition, :generator_function, :generator_function_declaration];

is_function = is_one_of function_kinds;

pattern_names p =
  if is_kind :identifier p or is_kind :shorthand_property_identifier_pattern p then [p]
  else if is_kind :object_pattern p or is_kind :array_pattern p or is_kind :rest_pattern p then concat_map pattern_names (run named_children p)
  else if is_kind :pair_pattern p then concat_map pattern_names p#value
  else if is_kind :assignment_pattern p or is_kind :object_assignment_pattern p then concat_map pattern_names p#left
  else [];

declarator_names d = concat_map pattern_names d#name;

declaration_kind decl = case decl#kind of { [k] -> text k; _ -> "var"; };

is_var_scope n = is_function n or is_kind :program n;

var_scope_of = Filter (take 1 . run (ancestors | keep is_var_scope));

lexical_names stmt =
  if is_kind :lexical_declaration stmt then concat_map declarator_names (run (children_of_kind :variable_declarator) stmt)
  else if is_kind :class_declaration stmt or is_kind :function_declaration stmt or is_kind :generator_function_declaration stmt then stmt#name
  else if is_kind :import_statement stmt then run (descendants | keep import_binding) stmt
  else [];

is_import_clause n = is_kind :import_clause n or is_kind :namespace_import n;

names_import n =
  has (parent | #alias | keep (= n)) n
  or (null (run (parent | #alias) n) and has (parent | #name | keep (= n)) n);

import_binding n =
  is_kind :identifier n and has (parent | keep is_import_clause) n
  or (has (parent | of_kind :import_specifier) n and names_import n);

var_names scope = do {
  v <- run descendants scope;
  name <- run ((of_kind :variable_declaration | children_of_kind :variable_declarator | Filter declarator_names)
    <|> (of_kind :for_in_statement | keep ((= "var") . declaration_kind) | #left | Filter pattern_names))
    v;
  run (var_scope_of | keep (= scope)) v;
  return name;
};

declared scope =
  if is_kind :program scope then append (concat_map lexical_names (run named_children scope)) (var_names scope)
  else if is_kind :statement_block scope or is_kind :class_static_block scope then concat_map lexical_names (run named_children scope)
  else if is_kind :for_statement scope then concat_map lexical_names scope#initializer
  else if is_kind :for_in_statement scope then (if declaration_kind scope = "var" then [] else concat_map pattern_names scope#left)
  else if is_kind :catch_clause scope then concat_map pattern_names scope#parameter
  else if is_function scope then
    append (concat_map pattern_names (run ((#parameters | named_children) <|> #parameter) scope))
      (append (if is_kind :function_expression scope then scope#name else []) (var_names scope))
  else [];

declared_as ref scope = filter ((= text ref) . text) (declared scope);

resolve ref = take 1 $ run (ancestors | Filter (declared_as ref)) ref;

resolves_to binding ref = any (= binding) (resolve ref);

declares binding scope = any (= binding) (declared scope);

pattern_kinds = [:array_pattern, :object_pattern, :pair_pattern, :assignment_pattern, :object_assignment_pattern, :rest_pattern];

pattern_root = or_else (parent | keep (is_one_of pattern_kinds) | pattern_root) identity;

assigns_to root site =
  (is_kind :assignment_expression site or is_kind :augmented_assignment_expression site)
  and has (#left | keep (= root)) site;

for_in_to root site = is_kind :for_in_statement site and null site#kind and has (#left | keep (= root)) site;

write_site = do {
  root <- pattern_root;
  pure root | parent | (keep (assigns_to root) <|> keep (is_kind :update_expression) <|> keep (for_in_to root));
};

reference_kinds = [:identifier, :shorthand_property_identifier_pattern, :shorthand_property_identifier];

references binding = do {
  scope <- take 1 $ run (ancestors | keep (declares binding)) binding;
  r <- run descendants scope;
  guard $ is_one_of reference_kinds r and text r = text binding and not (r = binding);
  guard $ resolves_to binding r;
  return r;
};

last_of xs = case xs of { [] -> []; [x] -> [x]; _ : t -> last_of t; };

self_scope = parent | keep (is_one_of [:function_declaration, :generator_function_declaration, :function_expression, :class_declaration, :class]);

is_inside n outer = has (ancestors | keep (= outer)) n;

statement_level site = has (parent | of_kind :expression_statement) site;

is_write n = is_kind :assignment_expression n or is_kind :augmented_assignment_expression n or is_kind :update_expression n;

reads_for_itself binding r = do {
  site <- run (ancestors | keep is_write) r;
  guard $ statement_level site;
  target <- run (#left <|> #argument) site;
  guard $ is_kind :identifier target and resolves_to binding target;
  return r;
};

is_compound_write site = not (is_kind :assignment_expression site) and not (statement_level site);

is_read binding r =
  (not (has write_site r) or has (write_site | keep is_compound_write) r)
  and not (any (is_inside r) (run self_scope binding))
  and null (reads_for_itself binding r);

is_used binding = any (is_read binding) (references binding);

is_exported = has (ancestors | keep (is_kind :export_statement));

left_of p = if is_kind :assignment_pattern p then p#left else [p];

positional f = filter (is_kind :identifier) (concat_map left_of (run (#parameters | named_children) f));

drop_through x xs = case xs of { [] -> []; h : t -> if h = x then t else drop_through x t; };

used_after binding = do {
  f <- run (parent | parent | keep is_function) binding;
  let later = drop_through binding (positional f);
  return $ any is_used later;
};

declaration_names = do {
  scope <- identity <|> descendants;
  b <- pure scope | Filter declared;
  guard $ not $ is_exported b;
  guard $ not $ has (parent | of_kind :function_expression) b;
  return b;
};

last_write b = last_of (filter (has write_site) (references b));

unused_vars = do {
  b <- declaration_names;
  guard $ not $ is_used b;
  guard $ not $ any identity (used_after b);
  pure b | or_else (Filter last_write) identity;
};
