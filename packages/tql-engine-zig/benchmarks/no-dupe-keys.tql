data Member = Member String String Node;

accessor = or_else (children | keep (\t -> not (is_named t) and (kind_name t = "get" or kind_name t = "set")) | arr kind_name) (pure "init");

string_value s = case named_children s of {
  [] -> "";
  [f] -> text f;
  _ -> text s;
};

key_name =
  (of_kind :property_identifier | arr text)
  <|> (of_kind :string | arr string_value)
  <|> (of_kind :number | arr text)
  <|> (of_kind :computed_property_name | named_children | of_kind :string | arr string_value);

method m = do {
  k <- #name m;
  n <- key_name k;
  a <- accessor m;
  return $ Member n a m;
};

is_proto_setter m = has (#key | keep (\k -> not (is_kind :computed_property_name k)) | key_name | keep (\n -> n = "__proto__")) m;

member =
  (of_kind :pair | keep (\m -> not (is_proto_setter m)) | (\m -> (#key | key_name | arr (\n -> Member n "init" m)) m))
  <|> (of_kind :shorthand_property_identifier | arr (\n -> Member (text n) "init" n))
  <|> (of_kind :method_definition | method);

clashes x y = case x of {
  Member n a _ -> case y of {
    Member n2 b _ -> n = n2 and (a = "init" or b = "init" or a = b);
  };
};

dupes seen ms = case ms of {
  [] -> [];
  m : rest -> case m of {
    Member _ _ node ->
      append (if any (clashes m) seen then [node] else []) (dupes (m : seen) rest);
  };
};

main = descendants_of_kind :object | (\o -> dupes [] (concat_map member (named_children o)));
