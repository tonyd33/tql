is_loop n = is_kind :for_statement n or is_kind :while_statement n or is_kind :do_statement n;

goto_in_loop =
  descendants
  | keep (\n -> kind_name n = "goto_statement")
  | keep (has (ancestors | keep is_loop));

assignment_in_condition =
  named_descendants
  | keep (\n -> kind n = :assignment_expression)
  | keep (has (parent | keep (\p -> kind p = :parenthesized_expression) | parent | keep (\p -> kind p != :expression_statement)));

empty_block =
  named_descendants
  | keep (\n -> kind n = :compound_statement)
  | keep (\b -> length (children b) = 2);

wide_call =
  named_descendants
  | keep (\n -> kind n = :argument_list and length (named_children n) >= 6)
  | parent;

main =
  (goto_in_loop <|> assignment_in_condition <|> empty_block <|> wide_call)
  | arr (\n -> { kind = kind n, row = (range n).start_point.row });
