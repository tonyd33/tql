. / function_definition as @fn
| @fn / function_declarator as @fn_decl
| @fn_decl / identifier as @name
| @fn.body as @body
| select(
    any(@body // call_expression; ( .function | text() ) ~ /^(k|v|kv)(z|m|c|re)?alloc/) and
    any(@body // goto_statement; ( .label | text() ) ~ /^(err|out)(_\w+)?$/)
)
| { @name }
