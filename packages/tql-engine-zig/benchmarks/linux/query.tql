matches re = select (arr (\n -> text n ~ re));

allocator_call =
  descendants
  | is_kind :call_expression
  | .function
  | matches r"^(k|v|kv)(z|m|c|re)?alloc";

error_goto =
  descendants
  | is_kind :goto_statement
  | .label
  | matches r"^(err|out)(_\w+)?$";

main =
  descendants
  | is_kind :function_definition
  | select (.body | exists allocator_call)
  | select (.body | exists error_goto)
  | children | is_kind :function_declarator
  | children | is_kind :identifier
  | arr (\n -> { name = text n });
