is_one_of ks n = any (= kind n) ks;

function_kinds = [:function_declaration, :function_expression, :arrow_function, :method_definition, :generator_function, :generator_function_declaration];

is_function = is_one_of function_kinds;

pattern_names p =
  if is_kind :identifier p or is_kind :shorthand_property_identifier_pattern p then [p]
  else if is_kind :object_pattern p or is_kind :array_pattern p or is_kind :rest_pattern p then concat_map pattern_names (named_children p)
  else if is_kind :pair_pattern p then concat_map pattern_names (#value p)
  else if is_kind :assignment_pattern p or is_kind :object_assignment_pattern p then concat_map pattern_names (#left p)
  else [];

declarator_names d = concat_map pattern_names (#name d);

declaration_kind decl = case #kind decl of { [k] -> text k; _ -> "var"; };

is_var_scope n = is_function n or is_kind :program n;

var_scope_of = first (ancestors | keep is_var_scope);

lexical_names stmt =
  if is_kind :lexical_declaration stmt then concat_map declarator_names (children_of_kind :variable_declarator stmt)
  else if is_kind :class_declaration stmt or is_kind :function_declaration stmt or is_kind :generator_function_declaration stmt then #name stmt
  else if is_kind :import_statement stmt then (descendants | keep import_binding) stmt
  else [];

is_import_clause n = is_kind :import_clause n or is_kind :namespace_import n;

names_import n =
  has (parent | #alias | keep (= n)) n
  or (null ((parent | #alias) n) and has (parent | #name | keep (= n)) n);

import_binding n =
  is_kind :identifier n and has (parent | keep is_import_clause) n
  or (has (parent | of_kind :import_specifier) n and names_import n);

var_names scope = do {
  v <- descendants scope;
  name <- (of_kind :variable_declaration | children_of_kind :variable_declarator | declarator_names)
    <|> (of_kind :for_in_statement | keep ((= "var") . declaration_kind) | #left | pattern_names)
    $ v;
  first (var_scope_of | keep (= scope)) v;
  return name;
};

declared scope =
  if is_kind :program scope then append (concat_map lexical_names (named_children scope)) (var_names scope)
  else if is_kind :statement_block scope or is_kind :class_static_block scope then concat_map lexical_names (named_children scope)
  else if is_kind :for_statement scope then concat_map lexical_names (#initializer scope)
  else if is_kind :for_in_statement scope then (if declaration_kind scope = "var" then [] else concat_map pattern_names (#left scope))
  else if is_kind :catch_clause scope then concat_map pattern_names (#parameter scope)
  else if is_function scope then
    append (concat_map pattern_names (((#parameters | named_children) <|> #parameter) scope))
      (append (if is_kind :function_expression scope then #name scope else []) (var_names scope))
  else [];

declared_as ref scope = filter ((= text ref) . text) (declared scope);

resolve ref = first (ancestors | declared_as ref) ref;

resolves_to binding ref = any (= binding) (resolve ref);

declares binding scope = any (= binding) (declared scope);

pattern_kinds = [:array_pattern, :object_pattern, :pair_pattern, :assignment_pattern, :object_assignment_pattern, :rest_pattern];

pattern_root n = or_else (parent | keep (is_one_of pattern_kinds) | pattern_root) (pure n) n;

assigns_to root site =
  (is_kind :assignment_expression site or is_kind :augmented_assignment_expression site)
  and has (#left | keep (= root)) site;

for_in_to root site = is_kind :for_in_statement site and null (#kind site) and has (#left | keep (= root)) site;

write_site id = do {
  root <- pattern_root id;
  site <- parent root;
  (keep (assigns_to root) <|> keep (is_kind :update_expression) <|> keep (for_in_to root)) site;
};

reference_kinds = [:identifier, :shorthand_property_identifier_pattern, :shorthand_property_identifier];

references binding = do {
  scope <- first (ancestors | keep (declares binding)) binding;
  r <- descendants scope;
  guard $ is_one_of reference_kinds r and text r = text binding and not (r = binding);
  guard $ resolves_to binding r;
  return r;
};

last_of xs = case xs of { [] -> []; [x] -> [x]; _ : t -> last_of t; };

self_scope = parent | keep (is_one_of [:function_declaration, :generator_function_declaration, :function_expression, :class_declaration, :class]);

is_inside n outer = has (ancestors | keep (= outer)) n;

statement_level site = has (parent | of_kind :expression_statement) site;

is_write n = is_kind :assignment_expression n or is_kind :augmented_assignment_expression n or is_kind :update_expression n;

reads_for_itself binding r = do {
  site <- (ancestors | keep is_write) r;
  guard $ statement_level site;
  target <- (#left <|> #argument) site;
  guard $ is_kind :identifier target and resolves_to binding target;
  return r;
};

is_compound_write site = not (is_kind :assignment_expression site) and not (statement_level site);

is_read binding r =
  (null (write_site r) or has (write_site | keep is_compound_write) r)
  and not (any (is_inside r) (self_scope binding))
  and null (reads_for_itself binding r);

is_used binding = any (is_read binding) (references binding);

is_exported = has (ancestors | keep (is_kind :export_statement));

left_of p = if is_kind :assignment_pattern p then #left p else [p];

positional f = filter (is_kind :identifier) (concat_map left_of ((#parameters | named_children) f));

drop_through x xs = case xs of { [] -> []; h : t -> if h = x then t else drop_through x t; };

used_after binding = do {
  f <- (parent | parent | keep is_function) binding;
  let later = drop_through binding (positional f);
  return $ any is_used later;
};

declaration_names root = do {
  scope <- (pure root <|> descendants) root;
  b <- declared scope;
  guard $ not $ is_exported b;
  guard $ not $ has (parent | of_kind :function_expression) b;
  return b;
};

last_write b = last_of (filter (has write_site) (references b));

main root = do {
  b <- declaration_names root;
  guard $ not $ is_used b;
  guard $ not $ any identity (used_after b);
  or_else last_write (pure b) b;
};
